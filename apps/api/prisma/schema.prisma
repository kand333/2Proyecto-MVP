// Prisma schema. The connection URL is configured in prisma.config.ts.
// CHECK constraints are not expressible here: they live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Stored normalized (trimmed, lowercase) by the service layer.
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  // Declared at registration (calendar date, no time). Null for accounts created before it was asked.
  birthDate    DateTime? @db.Date
  // Sessions issued before this instant are rejected: set when the password changes (logs out other devices).
  sessionsValidAfter DateTime?
  // Last authenticated request (refreshed at most once a minute): "online" and "last connection" in the admin list.
  lastSeenAt   DateTime?
  // Logout time: offline at once while keeping lastSeenAt (online only when lastSeenAt is later).
  loggedOutAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Must match PRODUCT_CATEGORIES in @portal/shared/product (DEC-005).
enum ProductCategory {
  TERPENES
  VAPES
  E_LIQUIDS
  ACCESSORIES
}

model Product {
  id          String          @id @default(uuid(7)) @db.Uuid
  slug        String          @unique
  name        String
  description String
  category    ProductCategory
  // Only published, non-archived products with an active variant reach the public catalog.
  isPublished Boolean         @default(false)
  // Archiving replaces deletion: orders keep pointing at its variants.
  isArchived  Boolean         @default(false)
  variants    ProductVariant[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isPublished, isArchived, category])
}

model ProductVariant {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  // Stored trimmed and uppercase by the shared schema.
  sku       String  @unique
  // Whole CLP (DEC-003). CHECK priceClp > 0 and stock >= 0 live in the migration SQL.
  priceClp  Int
  stock     Int
  isActive  Boolean @default(true)
  position  Int

  @@index([productId, position])
}

// Example module: copy it (shared schema → repository → service → routes → tests → pages) for each
// new entity of a project, then delete it.
model Item {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  description String
  // Only published items reach the public pages.
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}
