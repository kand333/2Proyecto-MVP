// Prisma schema. The connection URL is configured in prisma.config.ts.
// CHECK constraints are not expressible here: they live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Stored normalized (trimmed, lowercase) by the service layer.
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  // Declared at registration (calendar date, no time). Null for accounts created before it was asked.
  birthDate    DateTime? @db.Date
  // Sessions issued before this instant are rejected: set when the password changes (logs out other devices).
  sessionsValidAfter DateTime?
  // Last authenticated request (refreshed at most once a minute): "online" and "last connection" in the admin list.
  lastSeenAt   DateTime?
  // Logout time: offline at once while keeping lastSeenAt (online only when lastSeenAt is later).
  loggedOutAt  DateTime?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Must match PRODUCT_CATEGORIES in @portal/shared/product (DEC-005).
enum ProductCategory {
  TERPENES
  VAPES
  E_LIQUIDS
  ACCESSORIES
}

model Product {
  id          String          @id @default(uuid(7)) @db.Uuid
  slug        String          @unique
  name        String
  description String
  category    ProductCategory
  // Only published, non-archived products with an active variant reach the public catalog.
  isPublished Boolean         @default(false)
  // Archiving replaces deletion: orders keep pointing at its variants.
  isArchived  Boolean         @default(false)
  // Shown in the home page's featured collection (RF-27).
  isFeatured  Boolean         @default(false)
  variants    ProductVariant[]
  images      ProductImage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isPublished, isArchived, category])
  @@index([isFeatured])
}

model ProductVariant {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  // Stored trimmed and uppercase by the shared schema.
  sku       String  @unique
  // Whole CLP (DEC-003). CHECK priceClp > 0 and stock >= 0 live in the migration SQL.
  priceClp  Int
  // Previous price of an offer (DEC-017). CHECK compareAtPriceClp > priceClp lives in the migration SQL.
  compareAtPriceClp Int?
  stock     Int
  isActive  Boolean @default(true)
  position  Int
  orderItems OrderItem[]

  @@index([productId, position])
}

// Example module: copy it (shared schema → repository → service → routes → tests → pages) for each
// new entity of a project, then delete it.
model Item {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  description String
  // Only published items reach the public pages.
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}

// Welcome code subscriber (RF-12, RF-13). The code gives 10 % off one first order.
model Subscriber {
  id               String    @id @default(uuid(7)) @db.Uuid
  // Stored trimmed and lowercase by the shared schema.
  email            String    @unique
  code             String    @unique
  marketingConsent Boolean
  consentAt        DateTime  @default(now())
  // Set when an order uses the code; cleared again if that order is cancelled (RF-15).
  redeemedAt       DateTime?
  // The order that redeemed the code; one code per order.
  redeemedOrderId  String?   @unique @db.Uuid
  redeemedOrder    Order?    @relation(fields: [redeemedOrderId], references: [id], onDelete: SetNull)

  @@index([consentAt])
}

// Shop settings (RF-10): a single row with id 1, created by its migration. Neutral defaults until the
// admin sets real values in /admin/settings.
model ShopSettings {
  id                   Int      @id @default(1)
  flatShippingClp      Int      @default(0)
  // Subtotal from which delivery is free; null = never free.
  freeShippingFromClp  Int?
  pickupAddress        String   @default("")
  transferInstructions String   @default("")
  updatedAt            DateTime @updatedAt
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  DELIVERY
  PICKUP
}

// An order (RF-08, RF-09): placed as a guest or with an account; totals are computed by the server.
model Order {
  id             String         @id @default(uuid(7)) @db.Uuid
  // Correlative number shown to the customer and the admin.
  number         Int            @unique @default(autoincrement())
  // Secret of /orders/[token] (DEC-007): 32 random bytes in base64url. The id is never exposed.
  accessToken    String         @unique
  // Guest orders have no user and are never linked by email (RF-16).
  userId         String?        @db.Uuid
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  name           String
  phone          String
  birthDate      DateTime       @db.Date
  status         OrderStatus    @default(PENDING_PAYMENT)
  shippingMethod ShippingMethod
  // Delivery address (null for pickup). The region is an ISO 3166-2:CL code (shared CHILE_REGIONS).
  region         String?
  commune        String?
  street         String?
  addressExtra   String?
  // Whole CLP (DEC-003). CHECKs (non-negative, total = subtotal - discount + shipping) live in the migration SQL.
  subtotalClp    Int
  discountClp    Int            @default(0)
  shippingClp    Int
  totalClp       Int
  discountCode   String?
  trackingNumber String?
  items          OrderItem[]
  redeemedCode   Subscriber?
  paidAt         DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([userId, createdAt])
}

// One line of an order, with a snapshot of what was bought: later product edits never change it.
model OrderItem {
  id           String         @id @default(uuid(7)) @db.Uuid
  orderId      String         @db.Uuid
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: a variant with orders is deactivated, never deleted.
  variantId    String         @db.Uuid
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName  String
  variantName  String
  sku          String
  unitPriceClp Int
  quantity     Int

  @@index([orderId])
  @@index([variantId])
}

// Product photo stored in Cloudinary (RF-21, DEC-012): only the URL and the public id, never the file.
model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // Cloudinary public_id: required to delete the remote asset.
  publicId  String   @unique
  // 0 is the cover of the catalog card.
  position  Int
  createdAt DateTime @default(now())

  @@index([productId, position])
}
