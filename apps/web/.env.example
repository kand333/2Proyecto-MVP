# =============================================================================
# FRONTEND (@portal/web) - environment variables template
# =============================================================================
# `npm run setup` copies this file to `.env.local` (not versioned).
# Never put backend secrets here: everything with NEXT_PUBLIC_ is visible in the browser.
# Server secrets: see apps/api/.env.example
# =============================================================================

# Public URL of the site (absolute URLs and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend URL reachable from the Next server (server only).
# /api/** is proxied here; set it before `next build`.
API_INTERNAL_URL=http://localhost:4000
